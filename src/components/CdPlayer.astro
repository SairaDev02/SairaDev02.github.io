---
// The CD player picture in its frame, with the LCD faceplate underneath. The canvas is
// drawn by scripts/player/cd-player.ts; the grid size here is the wide one and is replaced
// at runtime on phones.
import { createHash } from 'node:crypto';
import { NARROW, WIDE } from '../scripts/player/geometry';
import Lcd from './Lcd.astro';
import { GITHUB_USER } from '../lib/github';

interface Props {
  count: number;
}
const { count } = Astro.props;
// Grid sizes for the CSS that sizes the canvas before any script runs. They come from
// geometry.ts, so they are written as an inline style element rather than in the scoped
// <style> below. Its hash goes into the page's CSP: a style attribute would need an
// `'unsafe-inline'` exception, a hashed element needs none.
const grids = `[data-player]{--wide-w:${WIDE.W};--wide-h:${WIDE.H};--narrow-w:${NARROW.W};--narrow-h:${NARROW.H}}`;
Astro.csp?.insertStyleHash(`sha256-${createHash('sha256').update(grids).digest('base64')}`);
const alt = `A CD player in a cloudy sky beside ${count} discs, one per public repository. Loading a disc into the player opens that repository; the track list below does the same.`;
---

<style is:inline set:html={grids}></style>
<div class="wrap stage" data-player>
  <span class="rail label" aria-hidden="true">{GITHUB_USER}™ · public work</span>
  <div class="frame">
    <canvas width={WIDE.W} height={WIDE.H} role="img" aria-label={alt}></canvas>
    <Lcd total={count} />
  </div>
</div>

<style>
  /*
   * The canvas size is final from the first paint, so the page never shifts when the
   * script starts: the largest whole multiple (1 to 6) of the grid that fits the stage in
   * device pixels, as round(down, available device px, grid px) / dpr. The grid is the
   * wide one, or the portrait one under the same query as NARROW_QUERY in geometry.ts.
   * --dpr comes from media queries until player/cd-player.ts sets the exact value.
   */
  .stage {
    position: relative;
    container-type: inline-size;
    --dpr: 1;
    --grid-w: var(--wide-w);
    --grid-h: var(--wide-h);
  }
  @media (max-width: 600px) {
    .stage { --grid-w: var(--narrow-w); --grid-h: var(--narrow-h); }
  }
  @media (resolution >= 1.25dppx) { .stage { --dpr: 1.25; } }
  @media (resolution >= 1.5dppx) { .stage { --dpr: 1.5; } }
  @media (resolution >= 1.75dppx) { .stage { --dpr: 1.75; } }
  @media (resolution >= 2dppx) { .stage { --dpr: 2; } }
  @media (resolution >= 2.25dppx) { .stage { --dpr: 2.25; } }
  @media (resolution >= 2.5dppx) { .stage { --dpr: 2.5; } }
  @media (resolution >= 3dppx) { .stage { --dpr: 3; } }
  @media (resolution >= 3.5dppx) { .stage { --dpr: 3.5; } }
  @media (resolution >= 4dppx) { .stage { --dpr: 4; } }
  .frame {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    line-height: 0;
    background: var(--shade-0);
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 0 0 6px rgb(255 255 255 / 0.35), 0 24px 60px -20px rgb(29 63 208 / 0.55);
  }
  canvas {
    display: block;
    /* Minus the frame's 2px borders. */
    --avail: calc((100cqw - 4px) * var(--dpr));
    --grid: calc(var(--grid-w) * 1px);
    width: calc(clamp(var(--grid), round(down, var(--avail), var(--grid)), 6 * var(--grid)) / var(--dpr));
    max-width: 100%;
    height: auto;
    aspect-ratio: var(--grid-w) / var(--grid-h);
    image-rendering: pixelated;
    touch-action: pan-y;
  }
  .rail {
    display: none;
    position: absolute;
    right: -8px;
    top: 50%;
    writing-mode: vertical-rl;
    transform: translateY(-60%);
  }
  @media (min-width: 1200px) {
    .rail { display: block; }
  }
  /* A yellow star glinting over the frame's top-right corner. */
  .stage::after {
    content: '';
    position: absolute;
    right: 6%;
    top: -18px;
    width: 64px;
    height: 64px;
    pointer-events: none;
    background:
      radial-gradient(circle, var(--sun-core) 0 3px, rgb(255 214 10 / 0.7) 4px, transparent 20px),
      linear-gradient(90deg, transparent 0 45%, var(--sun) 50%, transparent 55% 100%) center / 100% 2px no-repeat,
      linear-gradient(0deg, transparent 0 45%, var(--sun) 50%, transparent 55% 100%) center / 2px 100% no-repeat;
    filter: drop-shadow(0 0 6px rgb(255 214 10 / 0.9));
  }
</style>
