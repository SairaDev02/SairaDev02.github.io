---
// Footer: a column per ready section that has footer content. Only Contact has any today,
// so the footer never shows an empty section or a placeholder.
import { READY_SECTIONS } from '../lib/sections';
import { SITE } from '../lib/site';

const contact = READY_SECTIONS.find((s) => s.id === 'contact');
const withoutScheme = (url: string) => url.replace(/^https:\/\//, '');
---

<footer class="wrap foot">
  {
    contact && (
      <div id={contact.id}>
        <p class="label">{contact.label}</p>
        <p>
          <a href={SITE.profiles.github} rel="me">{withoutScheme(SITE.profiles.github)}</a>
          <br />
          <a href={SITE.profiles.crates} rel="me">{withoutScheme(SITE.profiles.crates)}</a>
        </p>
      </div>
    )
  }
</footer>

<style>
  .foot {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    padding-top: 32px;
    padding-bottom: 32px;
    margin-top: 8px;
    border-top: 1px solid var(--line);
  }
  .foot p { margin: 0 0 6px; }
</style>
