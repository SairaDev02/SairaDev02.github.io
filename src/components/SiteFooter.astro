---
// Footer columns. Copy marked [placeholder] waits for the owner's text.
import { GITHUB_USER } from '../lib/github';
---

<footer class="wrap foot">
  <div id="writing">
    <p class="label">Writing</p>
    <p class="caption">No posts yet.</p>
  </div>
  <div id="resume">
    <p class="label">Resume</p>
    <p class="caption">Coming soon.</p>
  </div>
  <div id="contact">
    <p class="label">Contact</p>
    <p><a href={`https://github.com/${GITHUB_USER}`}>github.com/{GITHUB_USER}</a><br />[email placeholder]</p>
  </div>
  <p class="label mantra">Build<br />Break<br />Ship<br />Repeat<br /><span class="label-dim">[placeholder]</span></p>
</footer>

<style>
  .foot {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    padding-top: 32px;
    padding-bottom: 32px;
    margin-top: 8px;
    border-top: 1px solid var(--line);
  }
  .foot p { margin: 0 0 6px; }
  .caption { font: 400 13px/1.65 var(--body); color: var(--muted); }
  .mantra { line-height: 1.7; }
</style>
