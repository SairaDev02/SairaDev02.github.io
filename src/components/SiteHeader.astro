---
// Handle with a barcode, last-push readout, the main navigation and the theme setting.
import ThemeSetting from './ThemeSetting.astro';
import { GITHUB_USER } from '../lib/github';
import { READY_SECTIONS } from '../lib/sections';

interface Props {
  /**
   * Last push across all repositories, "2026.11.12". Leave it out on a page with no
   * repository data, such as the 404 page: the readout is then not rendered at all.
   */
  lastPush?: string;
}
const { lastPush } = Astro.props;
// Barcode bar widths (1-3 units) derived from the handle: decoration with a stable source.
// Each width is a class, not a style attribute, so the page's CSP needs no exception for
// inline style attributes.
const bars = [...GITHUB_USER].flatMap((ch) => {
  const c = ch.charCodeAt(0);
  return [1 + (c % 3), 1 + ((c >> 2) % 2), 1 + ((c >> 3) % 3)];
});
---

<header class="top">
<div class:list={['wrap', 'bar', { 'no-push': !lastPush }]}>
  <a class="brand" href="/">
    <span class="label">{GITHUB_USER} <sup>™</sup></span>
    <span class="barcode" aria-hidden="true">
      {bars.map((w) => <i class={`w${w}`} />)}
    </span>
  </a>
  {lastPush && (
    <p class="push">
      <span class="dots" aria-hidden="true"><b></b><b></b><b class="lit"></b></span>
      <span class="label">{lastPush}</span>
      <span class="label label-dim">Last push</span>
    </p>
  )}
  <nav class="nav" aria-label="Main">
    {READY_SECTIONS.map((s) => (
      <a href={s.href} aria-current={s.href === Astro.url.pathname ? 'page' : undefined}>{s.label}</a>
    ))}
  </nav>
  <ThemeSetting />
</div>
</header>

<style>
  /* Sticky on wide screens; on phones it scrolls away. The stock behind it keeps content
     from showing through. */
  .top { background: var(--bg); border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) {
    .top { position: sticky; top: 0; z-index: 50; }
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 24px;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  /* Brand, last push, navigation, theme setting: four columns. */
  @media (min-width: 900px) {
    .bar { grid-template-columns: 1fr 1fr auto auto; }
    .bar.no-push { grid-template-columns: 1fr auto auto; }
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    width: fit-content;
  }
  /* Not smaller than the 12 px floor for text. */
  .brand sup { font-size: 12px; }
  .barcode { display: flex; height: 18px; }
  .barcode i { display: block; height: 100%; margin-right: 2px; background: var(--fg); }
  /* Bars come in threes, one per handle character: a wider gap after each group. */
  .barcode i:nth-child(3n) { margin-right: 3px; }
  .barcode .w1 { width: 2px; }
  .barcode .w2 { width: 4px; }
  .barcode .w3 { width: 6px; }

  .push { display: none; align-items: center; gap: 12px; margin: 0; }
  @media (min-width: 900px) {
    .push { display: flex; }
  }
  .dots { display: inline-flex; gap: 5px; }
  .dots b { width: 10px; height: 10px; background: var(--fg); }
  .dots b.lit { background: var(--ink-c); }

  .nav { display: flex; }
  .nav a {
    font: 400 13px/1.65 var(--ui);
    min-height: 36px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    margin-left: -1px;
    text-decoration: none;
  }
  .nav a:first-child { margin-left: 0; }
  /* Hover is K, never yellow (yellow is the highlighter): the current-page treatment, inverted. */
  .nav a:hover { background: var(--fg); border-color: var(--fg); color: var(--bg); position: relative; }
  .nav a[aria-current='page'] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
    position: relative;
  }
</style>
