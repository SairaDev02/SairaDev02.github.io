---
// Track list: one row per repository with its number (a play icon on hover, equaliser
// bars while active), title and description, language, commit waveform, commits and last
// push. Rows are real links; scripts/home.ts opens a plain click's tab and plays the disc.
import type { Repo } from '../lib/github';
import { dotDate, languageOf, trackNo } from '../lib/format';
import Wave from './Wave.astro';

interface Props {
  repos: Repo[];
}
const { repos } = Astro.props;
const max = Math.max(1, ...repos.flatMap((r) => r.wave));
---

<div class="tl">
  <div class="row head" aria-hidden="true">
    <span>#</span>
    <span>Title</span>
    <span class="c-lang">Language</span>
    <span class="c-wave">Activity</span>
    <span class="c-num">Commits</span>
    <span class="c-date">Updated</span>
  </div>
  <ol class="list">
    {
      repos.map((r, i) => (
        <li>
          <a class="row" href={r.url} data-track={i}>
            <span class="num">
              <span class="n">{trackNo(i)}</span>
              <svg class="pi" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5v14l11-7z" fill="currentColor" />
              </svg>
              <span class="eq" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            </span>
            <span class="title">
              <b>{r.name}</b>
              <small>{r.description ?? 'No description.'}</small>
            </span>
            <span class="c-lang lang">{languageOf(r)}</span>
            <span class="c-wave">
              <Wave wave={r.wave} max={max} />
            </span>
            <span class="c-num commits">
              {r.commits}
              <span class="visually-hidden">commits</span>
            </span>
            <span class="c-date date">{dotDate(r.pushedAt)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .tl { --cols: 2.5rem minmax(0, 1fr) auto; }
  @media (min-width: 760px) {
    .tl { --cols: 2.5rem minmax(0, 2.4fr) 7rem minmax(0, 1.6fr) 4.5rem 6rem; }
  }
  .list { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 16px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
  }
  .head {
    font: 400 11px/1.4 var(--ui);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    margin-bottom: 6px;
  }
  /* Phones: number, title and the commit count only. */
  .c-lang, .c-wave, .c-date { display: none; }
  @media (min-width: 760px) {
    .c-lang, .c-wave, .c-date { display: block; }
  }
  .c-num, .c-date { text-align: right; }

  .num { position: relative; display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--accent); }
  .n { font: 400 13px/1 var(--ui); letter-spacing: 0.08em; }
  .pi, .eq { display: none; }
  .pi { width: 16px; height: 16px; }
  .row:hover .n, .row:focus-visible .n { display: none; }
  .row:hover .pi, .row:focus-visible .pi { display: block; }
  /* Active track: equaliser bars replace the number. */
  .row:global(.on) .n, .row:global(.on) .pi { display: none; }
  .row:global(.on) .eq { display: flex; }
  .eq { gap: 2px; align-items: flex-end; height: 14px; }
  .eq i { width: 3px; background: var(--on-sun); transform-origin: bottom; animation: eq 0.9s ease-in-out infinite alternate; }
  .eq i:nth-child(1) { height: 40%; animation-delay: -0.3s; }
  .eq i:nth-child(2) { height: 100%; animation-delay: -0.6s; }
  .eq i:nth-child(3) { height: 65%; }
  @keyframes eq {
    from { transform: scaleY(0.3); }
    to { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eq i { animation: none; }
  }

  .title { display: flex; flex-direction: column; min-width: 0; }
  .title b { font: 500 15px/1.3 var(--ui); overflow-wrap: anywhere; }
  .title small { font: 400 12px/1.45 var(--body); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lang { font: 400 13px/1.4 var(--body); color: var(--muted); }
  .c-wave { color: rgb(29 63 208 / 0.55); }
  .commits { font: 600 13px/1 var(--wide); color: var(--accent); }
  .date { font: 400 12px/1 var(--body); color: var(--muted); }

  .list .row:hover { background: rgb(255 255 255 / 0.55); }
  .list .row:global(.on) { background: var(--sun); color: var(--on-sun); }
  .list .row:global(.on) * { color: var(--on-sun); }
  /* The cued row, the one the Dock's Play plays: a steady light blue glow box replacing the
     old left bar. Idle, it also carries a faint blue fill; the playing row keeps its solid
     yellow. */
  .list .row:global(.cued) {
    box-shadow: 0 0 0 1px var(--cue), 0 0 22px 4px color-mix(in srgb, var(--cue) 55%, transparent);
  }
  .list .row:global(.cued:not(.on)) { background: color-mix(in srgb, var(--cue) 18%, transparent); }
  /* A preview (a pointer over the row or focus on it) is a soft, blurred yellow wash behind
     the row, not a fill: the fill belongs to the play. */
  .list .row { position: relative; isolation: isolate; }
  .list .row:global(.hov) { background: transparent; }
  .list .row:global(.hov)::before {
    content: '';
    position: absolute;
    inset: 4px 8px;
    z-index: -1;
    border-radius: 14px;
    background: var(--sun);
    opacity: 0.6;
    filter: blur(12px);
    pointer-events: none;
  }
  .row:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
</style>
