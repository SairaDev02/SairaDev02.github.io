---
// The CD player's LCD faceplate, built into the bottom of the picture frame. Its height
// is fixed, so long descriptions scroll as a marquee instead of reflowing the page. Real
// DOM text keeps it legible and readable by screen readers. Driven by player/lcd.ts.
import { countLabel, IDLE_INFO, IDLE_TITLE } from '../scripts/player/lcd';

interface Props {
  total: number;
}
const { total } = Astro.props;
---

<div class="lcd" data-lcd data-flag="drag">
  <!-- The counter repeats the picture's own display, which is decoration: not announced. -->
  <div class="counter" aria-hidden="true">
    <span class="ghost">88</span>
    <span class="num" data-lcd-num>--</span>
    <span class="of" data-lcd-of>{countLabel(total)}</span>
  </div>
  <div class="main">
    <div class="title" data-lcd-title>{IDLE_TITLE}</div>
    <div class="info" data-lcd-info><span class="run" data-lcd-run>{IDLE_INFO}</span></div>
  </div>
  <ul class="flags" aria-hidden="true">
    <li data-f="drag">Drag</li>
    <li data-f="load">Load</li>
  </ul>
  <!-- In the initial HTML and hidden: reachable with Tab only while a disc plays. -->
  <button type="button" class="eject" data-lcd-eject hidden>
    <span class="glyph" aria-hidden="true">⏏</span><span class="word">Eject</span>
  </button>
</div>

<style>
  .lcd {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    height: 64px; /* fixed: content never changes the layout */
    /* Take the frame's width (set by the canvas) without widening it with long text. */
    width: 0;
    min-width: 100%;
    padding: 0 16px;
    line-height: 1.2;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, #0e1a52, #0b1440);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.08), inset 0 -1px 0 rgb(0 0 0 / 0.4);
    color: var(--sun);
    font-family: var(--pixel);
    text-shadow: 0 0 6px rgb(255 214 10 / 0.55);
    user-select: none;
  }
  /* Plex Mono digits: Pixelify's 2 and 5 read as 8 and 9 at this size. */
  .counter { position: relative; display: flex; align-items: baseline; gap: 2px; font-family: var(--body); }
  .ghost,
  .num { font-size: 34px; font-weight: 700; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .ghost { position: absolute; left: 0; top: 0; color: rgb(255 214 10 / 0.1); text-shadow: none; }
  .num { position: relative; min-width: 2ch; }
  .of { font-size: 13px; color: rgb(255 214 10 / 0.6); }

  .main { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .info {
    font-family: var(--body);
    font-size: 13px;
    color: #eef3ff;
    text-shadow: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .run { display: inline-block; }
  .info:global(.marquee) {
    text-overflow: clip;
    /* Fade the scrolling text out at both edges. */
    mask-image: linear-gradient(90deg, transparent 0, #000 12px, #000 calc(100% - 16px), transparent);
  }
  .info:global(.marquee) .run {
    padding-left: 12px;
    animation: marquee var(--dur, 10s) linear 1.2s infinite;
  }
  @keyframes marquee {
    to { transform: translateX(calc(-1 * var(--dist, 0px))); }
  }

  .flags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: right;
  }
  .flags li { color: rgb(255 214 10 / 0.18); text-shadow: none; }
  .lcd[data-flag='drag'] [data-f='drag'],
  .lcd[data-flag='load'] [data-f='load'] { color: var(--sun); text-shadow: 0 0 6px rgb(255 214 10 / 0.7); }

  /* Eject takes the lamps' place while a disc plays: the lamps own the third column
     otherwise, so only one of the two is ever in the grid. */
  .lcd:global(.has-eject) .flags { display: none; }
  .eject {
    font: 700 11px/1 var(--pixel);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-sun);
    background: var(--sun);
    border: 0;
    border-radius: 999px;
    padding: 8px 12px;
    min-height: 32px;
    cursor: pointer;
    box-shadow: 0 0 12px rgb(255 214 10 / 0.6);
  }
  .eject[hidden] { display: none; }
  .glyph { font-family: var(--ui); }
  /* The page's accent ring is too dark on the faceplate's navy. */
  .eject:focus-visible { outline: 2px solid var(--shade-3); outline-offset: 2px; }

  @media (max-width: 420px) {
    .lcd { gap: 8px; padding: 0 8px; }
    .flags { display: none; }
    .ghost, .num { font-size: 24px; }
    .title { font-size: 14px; }
    .info { font-size: 12px; }
    /* No room for the word beside the digits and the title: the glyph alone, at a size a
       thumb can hit. The button keeps its name for screen readers. */
    .word { display: none; }
    .eject { width: 36px; height: 36px; padding: 0; font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .info:global(.marquee) .run { animation: none; }
  }
</style>
