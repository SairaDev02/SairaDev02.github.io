---
// The asset board: one row per public repository, as the Sensor CMYK prototype drew it
// (prototype/defense at c3d5057, ?d=4). Each row is a link to the repository: its number
// (01..., the A-01... tag in the view), the name in capitals over its description, the
// stack, the telemetry bars, the commit count and the uplink date. Active shows a filled dot
// in the live ink before the date, Dormant an open one, and each also says so in text.
// Hovering or focusing a row is a Preview (scripts/preview.ts): here it only styles the
// row. scripts/home.ts opens a plain click or Enter through the shared Open route and
// reveals "Opened ↗".
//
// What the scripts read: `a[data-asset]` is the row (its index), with data-tag, data-name,
// data-language, data-commits, data-pushed, data-status="active|dormant" (an AssetStatus),
// and data-opened="true" once opened. scripts/assets.ts parses them back into Asset objects.
// scripts/motion.ts counts up `.commits`, which holds the number alone.
import type { Repo } from '../lib/github';
import { assetNo, assetTag, dotDate, languageOf, statusOf } from '../lib/format';
import Wave from './Wave.astro';

interface Props {
  repos: Repo[];
  now: Date;
}
const { repos, now } = Astro.props;
const max = Math.max(1, ...repos.flatMap((r) => r.wave));
---

<div class="board">
  <div class="row head" aria-hidden="true">
    <span class="c-num">#</span>
    <span class="c-name">Asset</span>
    <span class="c-lang">Stack</span>
    <span class="c-wave">Telemetry</span>
    <span class="c-commits">Commits</span>
    <span class="c-date">Uplink</span>
  </div>
  <ol class="list">
    {
      repos.map((r, i) => {
        const status = statusOf(r.pushedAt, now);
        const active = status === 'active';
        return (
          <li>
            <a
              class="row"
              href={r.url}
              data-asset={i}
              data-tag={assetTag(i)}
              data-name={r.name}
              data-language={languageOf(r)}
              data-commits={r.commits}
              data-pushed={dotDate(r.pushedAt)}
              data-status={status}
            >
              <span class="c-num tag-no">{assetNo(i)}</span>
              <span class="c-name">
                <span class="title">
                  <b class="name">{r.name}</b>
                  <span class="visually-hidden">{active ? 'Active' : 'Dormant'}</span>
                  <span class="opened" hidden>Opened ↗</span>
                </span>
                {r.description && <small class="desc">{r.description}</small>}
              </span>
              <span class="c-lang lang">{languageOf(r)}</span>
              <span class="c-wave">
                <Wave wave={r.wave} max={max} />
              </span>
              <span class="c-commits">
                <span class="commits">{r.commits}</span>
                <span class="visually-hidden">{r.commits === 1 ? ' commit' : ' commits'}</span>
              </span>
              <span class="c-date">
                <span class="mark" aria-hidden="true">{active ? '●' : '○'}</span>
                <span class="date">{dotDate(r.pushedAt)}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  /* Phones: number, then the name over its description, then the count over the uplink. */
  .row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    grid-template-areas: 'num name commits' 'num name date';
    gap: 2px 14px;
    align-items: center;
    padding: 10px;
  }
  .c-num { grid-area: num; }
  .c-name { grid-area: name; }
  .c-lang { display: none; grid-area: lang; }
  .c-wave { display: none; grid-area: wave; }
  .c-commits { grid-area: commits; text-align: right; }
  .c-date { grid-area: date; text-align: right; }
  @media (min-width: 760px) {
    .row {
      grid-template-columns: 2.5rem minmax(0, 2.4fr) 7rem minmax(0, 1.6fr) 4.5rem 7.5rem;
      grid-template-areas: 'num name lang wave commits date';
      gap: 16px;
      padding: 8px 10px;
    }
    .c-lang, .c-wave { display: block; }
  }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { border-bottom: 1px solid var(--line); }
  /* .row.head: the column heads share the row grid, and must outrank .row's text colour. */
  .row.head {
    display: none;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-strong);
    font: 700 12px/1.4 var(--body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
  }
  @media (min-width: 760px) {
    .row.head { display: grid; }
  }

  .row { position: relative; color: var(--fg); text-decoration: none; }
  .tag-no { font: 400 13px/1 var(--ui); letter-spacing: 0.08em; text-align: center; }
  .head .c-num { text-align: center; }
  .c-name { display: flex; flex-direction: column; min-width: 0; }
  .title { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .name {
    display: inline-block;
    font: 700 15px/1.3 var(--body);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .desc { font: 400 12px/1.45 var(--body); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .opened { font: 700 12px/1.3 var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .lang { font: 400 13px/1.4 var(--body); color: var(--muted); }
  .commits { font: 600 13px/1.4 var(--wide); }
  .c-date { white-space: nowrap; }
  .date { font: 400 12px/1.4 var(--body); color: var(--muted); }
  /* The mark is a character, so it takes the text inks: Active cyan, Dormant grey. */
  .mark { margin-right: 6px; font: 400 12px/1 var(--body); color: var(--muted); }
  [data-status='active'] .mark { color: var(--ink-c-text); }
  /* Telemetry is K: the terrain's mid grey, brightening to the text colour on a Preview. */
  .list .c-wave { color: var(--terrain-2); }

  /* Preview hooks: pointer or focus on a row. Magenta number, magenta brackets and a faint
     magenta tint; focus also draws the 2 px ring. The column heads share the grid, not this. */
  .list .row::before,
  .list .row::after {
    content: '';
    position: absolute;
    top: 3px;
    bottom: 3px;
    width: 8px;
    border: 0 solid var(--ink-m);
    opacity: 0;
    pointer-events: none;
  }
  .list .row::before { left: 0; border-width: 2px 0 2px 2px; }
  .list .row::after { right: 0; border-width: 2px 2px 2px 0; }
  .list .row:is(:hover, :focus-visible, [data-previewed='true']) {
    background: color-mix(in srgb, var(--ink-m) 7%, transparent);
    &::before,
    &::after { opacity: 1; }
    .tag-no { color: var(--ink-m-text); }
    /* The live dot darkens toward the text colour so it keeps 4.5:1 on the magenta tint. */
    &[data-status='active'] .mark { color: color-mix(in srgb, var(--ink-c-text) 65%, var(--fg)); }
    .c-wave { color: var(--fg); }
    /* The title steps right. */
    @media (prefers-reduced-motion: no-preference) {
      .title { translate: 6px 0; }
    }
  }
  /* A visible 2 px ring in the focus ink, outside the row and so beyond its corner
     brackets; an outline, so forced colours keep it. */
  .row:focus-visible { outline: 2px solid var(--ink-m); outline-offset: 2px; }
  @media (forced-colors: active) {
    .row:focus-visible { outline-color: Highlight; }
    .row:hover::before, .row:hover::after, .row:focus-visible::before, .row:focus-visible::after { border-color: Highlight; }
  }

  /* ---------- motion: only under no-preference; under reduce only colours change ---------- */
  @keyframes row-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  /* The yellow highlighter band rides the clip's edge. */
  @keyframes sweep { from { background-position: -50% 0; } to { background-position: 150% 0; } }
  @keyframes flash { from { background-color: color-mix(in srgb, var(--ink-m) 32%, transparent); } }
  @media (prefers-reduced-motion: no-preference) {
    .list li { position: relative; animation: row-in 380ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    .list li::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink-y) 35%, transparent) 70%, var(--ink-y) 99%, transparent) -50% 0 / 28% 100% no-repeat;
      animation: sweep 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    /* Stagger: scripts/motion.ts sets --row-delay on each row (70 ms apart from 420 ms). */
    .list li, .list li::after { animation-delay: var(--row-delay, 420ms); }
    /* Once each: after the reveal ends the row stays settled. */
    .list li[data-revealed], .list li[data-revealed]::after { animation: none; }
    /* Rows below the fold (marked by script after layout) reveal on a view timeline. Without
       view timelines they keep the time-based reveal above. */
    @supports (animation-timeline: view()) {
      .list li.later { view-timeline: --row block; }
      .list li.later, .list li.later::after {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-delay: 0s;
        animation-timeline: --row;
        animation-range: entry 10% entry 100%;
      }
    }
    /* Preview: the title steps right; the bars take their colour over 300 ms. */
    .title { transition: translate 220ms cubic-bezier(0.16, 1, 0.3, 1); }
    .c-wave { transition: color 300ms linear; }
    /* Open: the row flashes magenta once. */
    .row.flash { animation: flash 600ms ease-out; }
  }

  /* Decoding and counting (scripts/motion.ts): the real text stays in place, in the flow; an
     overlay in the page's background covers it and draws the changing glyphs, so the layout
     never moves with their widths. The script makes the overlay and adds the class, so
     neither carries this component's scope attribute: :global() on just those two. */
  :global(.text-live) { position: relative; }
  :global(.text-overlay) { position: absolute; inset: 0; background: var(--bg); color: inherit; text-align: inherit; pointer-events: none; }
</style>
