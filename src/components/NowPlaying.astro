---
// Fixed now-playing dock: cued track, transport, a commit-waveform progress fill, and the
// Lyrics and Queue panels that open above the bar. Behaviour lives in scripts/dock/dock.ts.
import type { Repo } from '../lib/github';
import Wave from './Wave.astro';

interface Props {
  repos: Repo[];
}
const { repos } = Astro.props;
---

<div class="dock" data-dock>
  <section class="panel lyrics" id="np-lyrics" data-panel="lyrics" hidden aria-label="Lyrics: README of the cued repository">
    <header class="panel-head">
      <span class="panel-title" data-lyrics-title>Lyrics</span>
      <a class="readme" href="#" data-readme>Full README ↗</a>
    </header>
    <ol class="lines" data-lines></ol>
  </section>

  <section class="panel queue" id="np-queue" data-panel="queue" hidden aria-label="Queue">
    <header class="panel-head">
      <span class="panel-title">Queue</span>
      <span class="small-label">Drag ⠿ or use ↑ ↓ to reorder</span>
      <!-- Under 600 px the bar has no room for Shuffle, so the panel's header carries it. -->
      <button type="button" class="q-shuffle" data-np="shuffle" aria-pressed="false" aria-label="Shuffle the queue">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M3 7h4l10 10h4M3 17h4l3-3M14 10l3-3h4M18 4l3 3-3 3M18 14l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.8"
          ></path></svg
        >
      </button>
    </header>
    <p class="small-label q-label" data-q-kicker>Ready to play</p>
    <ol class="q-list" data-q-now></ol>
    <p class="small-label q-label">Next in queue</p>
    <ol class="q-list" data-q-next></ol>
    <template data-q-item>
      <li class="q-item">
        <span class="q-handle" data-q-handle aria-hidden="true">⠿</span>
        <span class="q-num" data-q-num></span>
        <button type="button" class="q-pick" data-q-pick><b data-q-name></b><small data-q-meta></small></button>
        <span class="q-move" data-q-move>
          <button type="button" data-move="-1">↑</button>
          <button type="button" data-move="1">↓</button>
        </span>
      </li>
    </template>
  </section>

  <div class="bar" role="region" aria-label="Now playing">
    <div class="track">
      <span class="disc" aria-hidden="true"></span>
      <div class="meta">
        <span class="small-label" data-np-kicker>Ready to play</span>
        <b class="title" data-np-title></b>
        <span class="sub" data-np-sub></span>
      </div>
    </div>

    <div class="center">
      <div class="ctrl">
        <button type="button" class="shuffle" data-np="shuffle" aria-pressed="false" aria-label="Shuffle the queue">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M3 7h4l10 10h4M3 17h4l3-3M14 10l3-3h4M18 4l3 3-3 3M18 14l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.8"
            ></path></svg
          >
        </button>
        <button type="button" data-np="prev" aria-label="Previous track">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M6 5v14M19 5 8 12l11 7z" fill="currentColor" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg
          >
        </button>
        <button type="button" data-np="play" class="play" aria-label="Play the cued repository, opens in a new tab">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
          <svg class="i-reopen" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </button>
        <button type="button" data-np="next" aria-label="Next track">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M18 5v14M5 5l11 7-11 7z" fill="currentColor" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg
          >
        </button>
      </div>
      <div class="scrub">
        <span class="t" data-np-first></span>
        <!-- A progress fill, not a scrubber: nothing here is focusable, named or clickable. -->
        <div class="waves" aria-hidden="true">
          {
            repos.map((r, i) => (
              <div class="wave" data-wave hidden={i !== 0}>
                <Wave wave={r.wave} class="base" />
                <div class="fill" data-wave-fill>
                  <Wave wave={r.wave} class="played" />
                </div>
              </div>
            ))
          }
        </div>
        <span class="t" data-np-last></span>
      </div>
    </div>

    <div class="right">
      <div class="stat">
        <span class="commits" data-np-commits></span>
        <span class="small-label">lifetime · first → last commit</span>
      </div>
      <div class="tools">
        <button type="button" data-np-panel="lyrics" aria-expanded="false" aria-controls="np-lyrics" aria-label="Lyrics">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 6h10M4 11h10M4 16h6M17 4v11.5a2.5 2.5 0 1 1-2-2.45" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
            ></path></svg
          >
        </button>
        <button type="button" data-np-panel="queue" aria-expanded="false" aria-controls="np-queue" aria-label="Queue">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M4 6h16M4 12h16M4 18h10M17 15l4 3-4 3z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    pointer-events: none;
  }
  .dock > * { pointer-events: auto; }
  .small-label {
    font: 400 11px/1.4 var(--ui);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ---------- bar ---------- */
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto; /* phones: track, controls, tools */
    gap: 8px 12px;
    align-items: center;
    padding: 10px max(16px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(1.3);
    border-top: 1px solid var(--line);
    box-shadow: 0 -12px 40px -20px rgb(29 63 208 / 0.45);
  }
  @media (min-width: 900px) {
    .bar { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 8px 24px; }
  }
  .track { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .disc {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--accent) 0 3px, #fff 4px 9px, transparent 10px),
      conic-gradient(from 20deg, #dfe8ff, #fff 12%, #a9c3f6 25%, #fff 40%, var(--sun) 48%, #fff 55%, #a9c3f6 70%, #fff 85%, #dfe8ff);
    box-shadow: inset 0 0 0 1px rgb(29 63 208 / 0.3);
  }
  .dock:global(.is-playing) .disc { animation: spin 0.9s linear infinite; }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .meta { display: flex; flex-direction: column; min-width: 0; }
  .title { font: 600 15px/1.3 var(--ui); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sub { font: 400 12px/1.4 var(--body); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .center { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ctrl { display: flex; justify-content: center; align-items: center; gap: 10px; }
  .bar button {
    all: unset;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--fg);
  }
  .bar button svg { width: 18px; height: 18px; }
  .bar button:hover { color: var(--accent); }
  .bar button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bar button[aria-pressed='true'],
  .bar button[aria-expanded='true'] { color: var(--accent); background: rgb(255 214 10 / 0.55); }
  .ctrl .play {
    width: 40px;
    height: 40px;
    background: var(--sun);
    color: var(--on-sun);
    box-shadow: 0 0 0 1px var(--accent), 0 0 18px rgb(255 214 10 / 0.6);
  }
  .ctrl .play:hover { color: var(--on-sun); transform: scale(1.06); }
  /* A running play turns Play into Reopen: the tab is already open. */
  .play .i-reopen { display: none; }
  .dock:global(.is-playing) .ctrl .play .i-play { display: none; }
  .dock:global(.is-playing) .ctrl .play .i-reopen { display: block; }
  @media (max-width: 599px) {
    .ctrl { gap: 2px; }
    .ctrl .shuffle { display: none; }
    .disc { width: 36px; height: 36px; }
  }

  .scrub { display: none; align-items: center; gap: 10px; }
  @media (min-width: 900px) {
    .scrub { display: flex; }
  }
  .t { font: 400 11px/1 var(--body); color: var(--muted); white-space: nowrap; }
  .waves { position: relative; flex: 1; min-width: 0; }
  .wave { position: relative; }
  .wave :global(.base) { color: var(--line); }
  .fill { position: absolute; inset: 0; clip-path: inset(0 100% 0 0); transition: clip-path 0.25s linear; }
  .fill :global(.played) { color: var(--accent); }

  .right { display: flex; align-items: center; justify-content: flex-end; gap: 16px; }
  .stat { display: none; flex-direction: column; align-items: flex-end; text-align: right; }
  @media (min-width: 900px) {
    .stat { display: flex; }
  }
  .commits { font: 600 15px/1.3 var(--wide); color: var(--accent); }
  .tools { display: flex; gap: 2px; }

  /* ---------- panels above the bar ---------- */
  .panel {
    max-height: min(60vh, 520px);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 18px max(16px, env(safe-area-inset-right)) 22px max(16px, env(safe-area-inset-left));
  }
  .panel-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; }
  .panel-title { font: 600 14px/1.3 var(--wide); text-transform: uppercase; letter-spacing: 0.04em; }

  .lyrics {
    color: #fff;
    /* Deep cobalt rather than bright: every line here is read against the lightest point of
       this gradient, so it starts dark enough for 4.5:1 text (measured, ticket #31). */
    background: linear-gradient(165deg, #24409f 0%, #1a3189 45%, #0f1c66 100%);
    box-shadow: 0 -20px 50px -20px rgb(19 35 138 / 0.7);
  }
  .lyrics .panel-title { color: var(--sun); }
  .readme { font: 500 13px/1 var(--ui); color: #fff; white-space: nowrap; }
  .lines { list-style: none; margin: 0 auto; padding: 0; max-width: 58rem; }
  .lines :global(li) {
    font: 600 clamp(1.1rem, 2.2vw, 1.6rem)/1.35 var(--ui);
    color: rgb(255 255 255 / 0.66);
    margin: 0 0 6px;
    transition: color 0.3s;
  }
  .lines :global(li.past) { color: rgb(255 255 255 / 0.9); }
  .lines :global(li.now) { color: var(--sun); }
  .lines :global(li.tag) {
    font: 500 12px/1.4 var(--ui);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
    margin: 18px 0 8px;
  }
  .lines :global(li.empty) { color: rgb(255 255 255 / 0.85); font-weight: 400; }

  .queue {
    align-self: flex-end;
    width: min(100%, 440px);
    margin-right: max(0px, env(safe-area-inset-right));
    background: rgb(246 249 255 / 0.94);
    backdrop-filter: blur(16px);
    border: 1px solid var(--line);
    border-bottom: none;
    border-radius: 14px 14px 0 0;
    box-shadow: 0 -16px 40px -18px rgb(29 63 208 / 0.5);
  }
  .queue .panel-title { color: var(--accent); }
  .q-label { margin: 10px 0 4px; }
  /* Shuffle lives here on phones, where the bar's controls keep their five buttons. */
  .q-shuffle {
    all: unset;
    display: none;
    align-self: center;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--accent);
  }
  .q-shuffle svg { width: 18px; height: 18px; }
  .q-shuffle:hover { background: rgb(29 63 208 / 0.1); }
  .q-shuffle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .q-shuffle[aria-pressed='true'] { background: var(--sun); color: var(--on-sun); }
  @media (max-width: 599px) {
    .q-shuffle { display: grid; }
  }
  .q-list { list-style: none; margin: 0; padding: 0; }
  .q-item {
    display: grid;
    grid-template-columns: 22px 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border-radius: 8px;
    user-select: none;
  }
  .q-item:hover { background: rgb(29 63 208 / 0.07); }
  .q-item:global(.dragging) { background: var(--sun); box-shadow: 0 8px 20px -8px rgb(12 18 51 / 0.5); position: relative; z-index: 2; }
  .q-item:global(.q-now) { background: var(--sun); }
  .q-handle { cursor: grab; color: var(--muted); font-size: 16px; text-align: center; touch-action: none; }
  .q-item:global(.q-now) .q-handle { visibility: hidden; }
  .q-num { font: 400 12px/1 var(--ui); color: var(--accent); }
  .q-pick { all: unset; cursor: pointer; min-width: 0; display: flex; flex-direction: column; }
  .q-pick b { font: 500 14px/1.3 var(--ui); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .q-pick small { font: 400 12px/1.3 var(--body); color: var(--muted); }
  .q-pick:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .q-move { display: flex; gap: 2px; }
  .q-move button {
    all: unset;
    cursor: pointer;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--accent);
    font-size: 13px;
  }
  .q-move button:hover { background: rgb(29 63 208 / 0.1); }
  .q-move button:focus-visible { outline: 2px solid var(--accent); }
  .q-move button:disabled { visibility: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .dock:global(.is-playing) .disc { animation: none; }
    .lines :global(li) { transition: none; }
  }
</style>
