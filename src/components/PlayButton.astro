---
// Play: plays the cued repository. The playlist header and the dock each carry one; dock.ts
// finds both by data-np="play" and gives them the same name and glyph, so they never
// disagree. A running play renames Play to Reopen (the tab is already open) and adds
// .is-reopen, which swaps ▶ for ↗.
import Button from './Button.astro';

interface Props {
  size: 'md' | 'lg';
}
const { size } = Astro.props;
---

<Button variant="sun" size={size} data-np="play" aria-label="Play the cued repository, opens in a new tab">
  <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
  <svg class="i-reopen" viewBox="0 0 24 24" aria-hidden="true"
    ><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
  >
</Button>

<style>
  .i-reopen { display: none; }
  :global(.is-reopen) > .i-play { display: none; }
  :global(.is-reopen) > .i-reopen { display: block; }
</style>
