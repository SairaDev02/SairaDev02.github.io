---
// The link preview card's source, in Sensor CMYK. Dev-only, injected at /og-card by an
// inline integration in astro.config.mjs, and exported to src/assets/og-card.png by
// `npm run og:export`. Its output must never contain nightly repository data, so the view
// shows fixed Assets with tags only, and the text is static.
//
// The picture is the site's own sensor view (scripts/sensor/scene.ts), drawn as one still
// frame: with no input the scene holds its first frame's time, so every export is the same.
// The card prints on key black (Dark), where the inks read strongest in a feed; the export
// script sets the theme.
import BaseLayout from '../layouts/BaseLayout.astro';
import SensorView from '../components/SensorView.astro';
import { GITHUB_USER } from '../lib/github';
---

<BaseLayout title="Link preview card (dev only)" description="Dev-only source of the link preview image.">
  <div class="og" id="og-card">
    <SensorView />
    <div class="plate">
      <p class="label">Public repositories</p>
      <p class="mark">{GITHUB_USER}</p>
      <p class="line"><span class="chip"><span class="dot"></span>Systems online</span><span class="url">sairadev02.github.io</span></p>
    </div>
  </div>
</BaseLayout>

<script>
  import type { Asset } from '../scripts/assets';
  import { setPreview } from '../scripts/preview';
  import { mountSensor } from '../scripts/sensor/scene';

  // Placeholder Assets: tags and inks only (one live, one in focus, the rest dormant). Their
  // names only seed where each marker stands on the terrain.
  const statuses = ['active', 'dormant', 'dormant', 'dormant', 'dormant'] as const;
  const assets: Asset[] = statuses.map((status, index) => ({
    index,
    tag: `A-${String(index + 1).padStart(2, '0')}`,
    name: `asset-${index + 1}`,
    url: 'about:blank',
    language: 'Text',
    commits: 0,
    pushed: '',
    status,
  }));
  const FOCUS = 1;

  const card = document.getElementById('og-card') as HTMLElement;
  const frame = card.querySelector<HTMLElement>('[data-sensor-frame]')!;

  const nextFrame = () => new Promise((resolve) => requestAnimationFrame(resolve));

  async function draw() {
    mountSensor(frame, assets);
    setPreview(FOCUS);
    // The export script waits for this: the picture drawn, and the text set in the
    // self-hosted faces, so a re-export doesn't race the fonts and fall back to a local one.
    const faces = ['400 22px "IBM Plex Mono"', '700 22px "IBM Plex Mono"', '600 120px "Lexend Exa Variable"'];
    await Promise.all(faces.map((face) => document.fonts.load(face)));
    await document.fonts.ready;
    while (!frame.hasAttribute('data-ready')) await nextFrame();
    await nextFrame();
    await nextFrame();
    card.dataset.ogReady = 'true';
  }

  await draw();
</script>

<style>
  /* 1200x630, the Open Graph card size. The 2:1 safe area that some platforms crop to is
     the middle 1200x600, so nothing that matters sits in the top or bottom 15 px. */
  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
  }
  /* The view fills the top of the card: a 400x125 grid at 3x, edge to edge. The scene reads
     the grid from these two properties, as it does from SensorView's own. */
  .og :global(.sensor) { position: absolute; top: 15px; left: 0; width: 1200px; max-width: none; padding: 0; }
  .og :global(.sensor .frame) { --grid-w: 400; --grid-h: 125; border-width: 1px 0; }
  /* A card shows no live readouts and no Preview card: tags, brackets and corners only. */
  .og :global(.sensor .readout), .og :global(.sensor .card) { display: none; }

  /* The operator block, set large: label, wordmark, then the live chip and the address. */
  .plate {
    position: absolute;
    left: 64px;
    right: 64px;
    bottom: 34px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plate p { margin: 0; }
  .label {
    font: 400 22px/1.2 var(--body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mark {
    font: 600 108px/0.95 var(--wide);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .line { display: flex; align-items: center; gap: 28px; margin-top: 6px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border: 2px solid var(--ink-c-text);
    font: 700 20px/1 var(--body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-c-text);
  }
  .dot { width: 12px; height: 12px; background: var(--ink-c-text); }
  .url { font: 400 22px/1 var(--body); letter-spacing: 0.04em; color: var(--muted); }
</style>
