---
// Every page's title, description, canonical and structured data come from props, so a
// new page supplies its own. Canonical and JSON-LD are optional: a page that must not be
// indexed leaves them out.
// Fonts are self-hosted so first paint waits on no third-party stylesheet. Each import
// adds @font-face rules for every subset; browsers fetch only the subsets a page uses.
import '@fontsource-variable/lexend-exa';
import '@fontsource-variable/lexend';
import '@fontsource-variable/pixelify-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/global.css';
// Preloaded: Lexend Exa sets the largest text (the LCP element), and the CD player's
// canvas waits for Pixelify Sans before it can draw its lettering.
import lexendExa from '@fontsource-variable/lexend-exa/files/lexend-exa-latin-wght-normal.woff2?url';
import pixelify from '@fontsource-variable/pixelify-sans/files/pixelify-sans-latin-wght-normal.woff2?url';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** The absolute canonical URL; leave it out on pages that must not be indexed. */
  canonical?: string;
  /** The schema.org graph to embed; leave it out on pages without structured data. */
  jsonLd?: unknown;
  /**
   * The page's link preview image; leave it out on pages without one. `src` is the
   * site's URL for it (hashed under `/_astro/`), made absolute for og:image below.
   */
  image?: { src: string; type: string; width: number; height: number; alt: string };
}
const { title, description, canonical, jsonLd, image } = Astro.props;
const imageUrl = image && new URL(image.src, SITE.url).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {image && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content={image.type} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#dfe9fb" />
    <link rel="preload" href={lexendExa} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pixelify} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
