---
// Fonts are self-hosted so first paint waits on no third-party stylesheet. Each import
// adds @font-face rules for every subset; browsers fetch only the subsets a page uses.
import '@fontsource-variable/lexend-exa';
import '@fontsource-variable/lexend';
import '@fontsource-variable/pixelify-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/global.css';
// Preloaded: Lexend Exa sets the largest text (the LCP element), and the CD player's
// canvas waits for Pixelify Sans before it can draw its lettering.
import lexendExa from '@fontsource-variable/lexend-exa/files/lexend-exa-latin-wght-normal.woff2?url';
import pixelify from '@fontsource-variable/pixelify-sans/files/pixelify-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#dfe9fb" />
    <link rel="preload" href={lexendExa} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pixelify} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
