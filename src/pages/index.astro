---
// Home page: the owner's public repositories as a playlist, played on a dithered CD player.
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CdPlayer from '../components/CdPlayer.astro';
import NowPlaying from '../components/NowPlaying.astro';
import PlaylistHeader from '../components/PlaylistHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TrackList from '../components/TrackList.astro';
import ogCard from '../assets/og-card.png';
import { dotDate, toTrack } from '../lib/format';
import { GITHUB_USER, getRepos } from '../lib/github';
import { profileGraph } from '../lib/jsonld';
import { OG_IMAGE_ALT, SITE } from '../lib/site';
import { siteModifiedAtBuild } from '../lib/site-date';
import { serializeTracks } from '../lib/tracks';

const repos = await getRepos();
if (!repos.length) throw new Error(`No public repositories found for ${GITHUB_USER}.`);
const lastPush = dotDate(repos[0].pushedAt);
const jsonLd = profileGraph(SITE, await siteModifiedAtBuild());
// The committed card, served at its content-hashed /_astro/ URL. The output format is
// explicit: getImage otherwise re-encodes to webp.
const ogImage = await getImage({ src: ogCard, format: 'png' });
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  canonical={SITE.url}
  jsonLd={jsonLd}
  image={{ src: ogImage.src, type: `image/${ogCard.format}`, width: ogCard.width, height: ogCard.height, alt: OG_IMAGE_ALT }}
>
  <div class="page">
    <div class="sky" aria-hidden="true"></div>
    <a class="skip" href="#repositories">Skip to repositories</a>
    <SiteHeader lastPush={lastPush} />
    <main>
      <CdPlayer count={repos.length} />
      <section class="wrap playlist" id="repositories" tabindex="-1" aria-label="Repositories">
        <PlaylistHeader repos={repos} lastPush={lastPush} />
        <TrackList repos={repos} />
      </section>
    </main>
    <SiteFooter />
    <NowPlaying repos={repos} />
  </div>
  <script type="application/json" id="tracks" set:html={serializeTracks(repos.map(toTrack))} />
</BaseLayout>

<script>
  import '../scripts/home';
</script>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    /* Room for the fixed now-playing dock. */
    padding-bottom: var(--dock-h);
    isolation: isolate;
  }
  /* The first focus stop: out of sight until focused, then a pill over the header. It
     stays in the tab order and the accessibility tree, so it is moved, never hidden. */
  .skip {
    position: fixed;
    top: 8px;
    left: max(16px, env(safe-area-inset-left));
    z-index: 60;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font: 400 14px/1 var(--ui);
    text-decoration: none;
    transform: translateY(calc(-100% - 16px));
  }
  .skip:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .skip:focus { transform: none; }
  /* Where the skip link lands: a ring around the track list makes the jump visible. */
  .playlist:focus { outline: 3px solid var(--accent); outline-offset: 4px; }
  /* Pale sky with soft drifting clouds behind everything. The clouds sit on an oversized
     layer that drifts by transform, so the compositor animates it without repainting. */
  .sky {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .sky::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 140%;
    height: 140%;
    background:
      radial-gradient(60% 40% at 12% 18%, rgb(255 255 255 / 0.95), transparent 70%),
      radial-gradient(45% 30% at 78% 8%, rgb(255 255 255 / 0.8), transparent 70%),
      radial-gradient(50% 35% at 88% 62%, rgb(255 255 255 / 0.7), transparent 70%),
      radial-gradient(55% 40% at 20% 80%, rgb(255 255 255 / 0.75), transparent 70%),
      radial-gradient(120% 80% at 50% 120%, #9fbaf3, transparent 70%),
      linear-gradient(180deg, #f3f7ff 0%, #d3e2fb 60%, #b9cff6 100%);
    animation: drift 60s ease-in-out infinite alternate;
    will-change: transform;
  }
  /* The same path as the old background-position 0% 0% -> 100% 30% on a 140% background:
     40% of the sky's width across and 12% of its height down, as shares of this layer. */
  @keyframes drift {
    to { transform: translate(-28.5714%, -8.5714%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky::before { animation: none; }
  }
  /* The playlist is most of the page's first layout and starts below the picture on
     phones: skip laying it out until it nears the screen. The size is a placeholder
     until then; `auto` keeps the real one once known. */
  .playlist { padding-top: 40px; padding-bottom: 40px; content-visibility: auto; contain-intrinsic-size: auto 1200px; }
</style>
