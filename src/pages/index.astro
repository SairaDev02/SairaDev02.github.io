---
// Home page: the owner's public repositories as Assets. Top to bottom: the header, (the
// sensor view, a later slice), the operator block, the asset board, the footer. Opening is
// the only action.
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AssetBoard from '../components/AssetBoard.astro';
import OperatorBlock from '../components/OperatorBlock.astro';
import SensorView from '../components/SensorView.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ogCard from '../assets/og-card.png';
import { buildNow, dotDate, isActive } from '../lib/format';
import { GITHUB_USER, getRepos } from '../lib/github';
import { profileGraph } from '../lib/jsonld';
import { OG_IMAGE_ALT, SITE } from '../lib/site';
import { siteModifiedAtBuild } from '../lib/site-date';

const repos = await getRepos();
if (!repos.length) throw new Error(`No public repositories found for ${GITHUB_USER}.`);
const now = buildNow();
const active = repos.filter((r) => isActive(r.pushedAt, now)).length;
const lastPush = dotDate(repos[0].pushedAt);
const jsonLd = profileGraph(SITE, await siteModifiedAtBuild());
// The committed card, served at its content-hashed /_astro/ URL. The output format is
// explicit: getImage otherwise re-encodes to webp.
const ogImage = await getImage({ src: ogCard, format: 'png' });
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  canonical={SITE.url}
  jsonLd={jsonLd}
  image={{ src: ogImage.src, type: `image/${ogCard.format}`, width: ogCard.width, height: ogCard.height, alt: OG_IMAGE_ALT }}
>
  <div class="page">
    <a class="skip" href="#repositories">Skip to repositories</a>
    <!-- The page's one polite live region: Open and blocked-tab messages only (scripts/open.ts). -->
    <div class="visually-hidden" role="status" data-status></div>
    <SiteHeader lastPush={lastPush} />
    <main>
      <SensorView />
      <OperatorBlock repos={repos} active={active} lastPush={lastPush} />
      <section class="wrap board" id="repositories" tabindex="-1" aria-label="Repositories">
        <AssetBoard repos={repos} now={now} />
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  import '../scripts/home';
  import '../scripts/sensor/boot';
  import '../scripts/field/boot';
</script>

<style>
  .page { min-height: 100vh; }
  /* The background field (scripts/field/field.ts) fills the screen behind everything,
     scaled by whole pixels. It is fixed, so its arrival moves nothing. The scrim keeps the
     content column readable: the stock, solid behind the column and clear at the sides. */
  :global(.field) { position: fixed; top: 0; left: 0; z-index: -2; image-rendering: pixelated; pointer-events: none; }
  .page::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bg) 78%, transparent) 18%, color-mix(in srgb, var(--bg) 78%, transparent) 82%, transparent);
  }
  /* The first focus stop: out of sight until focused, then a pill over the header. It
     stays in the tab order and the accessibility tree, so it is moved, never hidden. */
  .skip {
    position: fixed;
    top: 8px;
    left: max(16px, env(safe-area-inset-left));
    z-index: 60;
    padding: 10px 18px;
    background: var(--fg);
    color: var(--bg);
    font: 400 14px/1 var(--ui);
    text-decoration: none;
    transform: translateY(calc(-100% - 16px));
  }
  .skip:focus-visible { outline: 2px solid var(--ink-m); outline-offset: 2px; }
  .skip:focus { transform: none; }
  /* Where the skip link lands: a ring around the board makes the jump visible.
     focus-visible, not focus: a click on plain text inside the board also focuses it
     (tabindex="-1"), and that should draw no ring. */
  .board:focus-visible { outline: 2px solid var(--ink-m); outline-offset: 4px; }
  .board { padding-top: 8px; padding-bottom: 48px; }
</style>
